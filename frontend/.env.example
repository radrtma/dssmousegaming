# Sesuaikan dengan lokasi folder project di htdocs.
# Untuk lokasi:
# D:\Software_Belajar\XAMPP\htdocs\git\dssmousegaming
# gunakan konfigurasi berikut:

VITE_API_BASE_URL=http://localhost/git/dssmousegaming/backend/api
VITE_BACKEND_PROXY_PATH=/git/dssmousegaming/backend/api

# Jika folder project dipindah, ubah git/dssmousegaming sesuai URL Apache.
# Contoh:
# VITE_API_BASE_URL=http://localhost/webdss/backend/api
# VITE_BACKEND_PROXY_PATH=/webdss/backend/api
